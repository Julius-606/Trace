# ==============================================================================
# PROJECT ORBIT & TRACE MODULAR SYSTEM — ENVIRONMENT CONFIGURATION
# File: .env.example (Copy to .env in your project root)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE DATABASE CREDENTIALS (Dual Neon PostgreSQL with Local SQLite Fallback)
# ------------------------------------------------------------------------------
TRACE_DATABASE_URL=postgresql://your_user:your_password@ep-sample-pooler.region.neon.tech/trace_db?sslmode=require
ORBIT_DATABASE_URL=postgresql://your_user:your_password@ep-sample-pooler.region.neon.tech/orbit_db?sslmode=require
DATABASE_URL=postgresql://your_user:your_password@ep-sample-pooler.region.neon.tech/trace_db?sslmode=require

# ------------------------------------------------------------------------------
# 2. APPLICATION AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
JWT_SECRET_KEY=your_64_character_jwt_secret_key_here
ORBIT_SECRET_KEY=your_64_character_orbit_secret_key_here
INTERNAL_API_KEY=64923e4d8f1a2c5b9e0f3d7a6c5b9eX0f3d7a6c5b9e0f3d7a
ADMIN_EMAIL=admin@trace.edu
ADMIN_PASSWORD=admin123

# ------------------------------------------------------------------------------
# 3. GOOGLE GEMINI AI CONFIGURATION (Orbit Brain, Quizzes & Socratic Reasoning)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY_1=your_gemini_api_key_1_here
GEMINI_API_KEY_2=your_gemini_api_key_2_here

# ------------------------------------------------------------------------------
# 4. WHATSAPP & META CLOUD API BOT (SSS Gateway & Student Alerts)
# ------------------------------------------------------------------------------
WHATSAPP_TOKEN=your_meta_system_user_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
WHATSAPP_VERIFY_TOKEN=orbit_trace_verify_token_2026
