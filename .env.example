ADMIN_PHONE_NUMBER=+254712345678

# ------------------------------------------------------------------------------
# 5. TELEGRAM BOT INTEGRATION (Study Bouncer, Moderation & Recall Challenges)
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret_here

# ------------------------------------------------------------------------------
# 6. DEBATEHUB & CROSS-APP INTEGRATION
# ------------------------------------------------------------------------------
DEBATEHUB_INTERNAL_URL=http://127.0.0.1:3000
DEBATEHUB_NEON_DATABASE_URL=postgresql://your_user:your_password@ep-sample-pooler.region.neon.tech/debatehub?sslmode=require

