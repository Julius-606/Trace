# ==============================================================================
# PROJECT ORBIT & TRACE MODULAR SYSTEM — ENVIRONMENT CONFIGURATION
# File: example.env (Copy to .env in your project root)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE DATABASE CREDENTIALS (Dual Neon PostgreSQL with Local SQLite Fallback)
# ------------------------------------------------------------------------------
# Neon cloud connection string for the primary Trace academic engine.
# Format: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
TRACE_DATABASE_URL=postgresql://your_user:your_password@ep-sample-pooler.region.neon.tech/trace_db?sslmode=require

# Neon cloud connection string for Orbit Socratic Life-OS & task matrix.
ORBIT_DATABASE_URL=postgresql://your_user:your_password@ep-sample-pooler.region.neon.tech/orbit_db?sslmode=require

# Optional fallback database URL if TRACE_DATABASE_URL is omitted (SQLite fallback is automatic).
DATABASE_URL=postgresql://your_user:your_password@ep-sample-pooler.region.neon.tech/trace_db?sslmode=require

# ------------------------------------------------------------------------------
# 2. APPLICATION AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# 64-character random string used to sign JWT Bearer access tokens.
# Generate via: openssl rand -hex 32
JWT_SECRET_KEY=your_64_character_jwt_secret_key_here
ORBIT_SECRET_KEY=your_64_character_orbit_secret_key_here

# Static API key shared between backend reverse proxy and the Trace client.
INTERNAL_API_KEY=64923e4d8f1a2c5b9e0f3d7a6c5b9eX0f3d7a6c5b9e0f3d7a

# Default SuperAdmin credentials seeded during initial database migration.
ADMIN_EMAIL=admin@trace.edu
ADMIN_PASSWORD=admin123

# ------------------------------------------------------------------------------
# 3. GOOGLE GEMINI AI CONFIGURATION (Orbit Brain, Quizzes & Socratic Reasoning)
# ------------------------------------------------------------------------------
# Primary Google AI Studio API Key (from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Secondary & fallback keys for high-throughput batch pre-generation rotation.
GEMINI_API_KEY_1=your_gemini_api_key_1_here
GEMINI_API_KEY_2=your_gemini_api_key_2_here

# ------------------------------------------------------------------------------
# 4. WHATSAPP & META CLOUD API BOT (SSS Gateway & Student Alerts)
# ------------------------------------------------------------------------------
# Meta Graph API Permanent System User Access Token (WhatsApp Business Platform)
WHATSAPP_TOKEN=your_meta_system_user_access_token_here

# Meta Cloud API Phone Number ID (from Meta Developer App Dashboard -> WhatsApp -> API Setup)
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here

# Webhook verification token entered into Meta App Dashboard Webhook callback settings.
WHATSAPP_VERIFY_TOKEN=orbit_trace_verify_token_2026

# Meta WhatsApp Business Account ID (WABA ID)
WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_business_account_id_here

# Optional Twilio fallback provider (if Meta Cloud API is not configured)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_NUMBER=+14155238886

# Admin phone number for critical syllabus publication and system alerts (E.164 format)
ADMIN_PHONE_NUMBER=+254712345678

# ------------------------------------------------------------------------------
# 5. TELEGRAM BOT INTEGRATION (Study Bouncer, Moderation & Recall Challenges)
# ------------------------------------------------------------------------------
# Telegram Bot Token generated from @BotFather (https://t.me/BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Optional secret string to validate inbound Telegram webhook requests (X-Telegram-Bot-Api-Secret-Token)
TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret_here

# ------------------------------------------------------------------------------
# 6. DEBATEHUB & CROSS-APP INTEGRATION
# ------------------------------------------------------------------------------
# Internal URL of the DebateHub Express engine (default port 3000)
DEBATEHUB_INTERNAL_URL=http://127.0.0.1:3000

# Dedicated Neon connection string for DebateHub parliamentary records
DEBATEHUB_NEON_DATABASE_URL=postgresql://your_user:your_password@ep-sample-pooler.region.neon.tech/debatehub?sslmode=require

# ------------------------------------------------------------------------------
# 7. METATRADER 5 (MT5) BOT TELEMETRY BRIDGE (Psych-Check Safeguards)
# ------------------------------------------------------------------------------
# MT5 account credentials monitored by PsychCheckEngine to lock trading on panic BPM.
MT5_LOGIN=your_mt5_login_number
MT5_PASSWORD=your_mt5_password
MT5_SERVER=MetaQuotes-Demo
