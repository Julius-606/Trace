# One local environment file is used by all backend modules.
# Keep these database URLs pointed at three different databases.
TRACE_DATABASE_URL=sqlite:///./edu_ai_vault.db
ORBIT_DATABASE_URL=sqlite:///./orbit_vault.db
DEBATEHUB_NEON_DATABASE_URL=

# Optional application secrets.
INTERNAL_API_KEY=
JWT_SECRET_KEY=
ADMIN_EMAIL=admin@trace.edu
ADMIN_PASSWORD=
GEMINI_API_KEY=
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
DEBATEHUB_INTERNAL_URL=http://127.0.0.1:3000

#TRACE_DATABASE_URL or ORBIT_DATABASE_URL
#JWT_SECRET_KEY or ORBIT_SECRET_KEY
#INTERNAL_API_KEY
#GEMINI_API_KEY / GEMINI_API_KEYS for AI features
#ADMIN_EMAIL and ADMIN_PASSWORD
#DEBATEHUB_NEON_DATABASE_URL or DEBATEHUB_DATABASE_URL
#MT5_LOGIN, MT5_PASSWORD, MT5_SERVER if MetaTrader is enabled
#TELEGRAM_BOT_TOKEN if Telegram integration is enabled
